#!/bin/bash
#PBS -q lecture1-c
#PBS -l select=1:mpiprocs=1
#PBS -l walltime=00:14:00
#PBS -W group_list=gt81
#PBS -j oe

# Single-threaded SwiGLU baseline on one Miyabi-C (Xeon Max) core.
#
#   cd <your checkout> && qsub scripts/miyabi/run_baseline_c.pbs
#
# group_list=gt81 is fixed by the course ("you do not need to and should never
# change it", pd00_intro.ipynb). Queues are lecture1-{mig,g,c} during the
# lecture slot (Mon 16:50-18:35) and lecture-{mig,g,c} outside it; the 15 minute
# educational walltime cap is why this asks for 14:00.

cd "$PBS_O_WORKDIR" || exit 1
source "$PBS_O_WORKDIR/scripts/miyabi/env_c.sh"

exec 2>&1
set -x

mkdir -p results
echo "=== host/compiler ==="
hostname
"$CXX" --version | head -2

cmake -B build -S . -DCMAKE_BUILD_TYPE=RelWithDebInfo || exit 1
cmake --build build -j || exit 1
ctest --test-dir build --output-on-failure || exit 1

REPEAT=${REPEAT:-20} scripts/run_baseline.sh | tee "results/baseline_$(hostname -s).csv"
